DEEPROMEO_API_KEY=
DEEPROMEO_API_BASE=https://api.deepseek.com
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
NEXT_PUBLIC_APP_URL=https://openromeo.rominur.com
NEXT_PUBLIC_ALIAS_URL=https://deepromeo.rominur.com

# Persistent storage. Leave unset on a host with a real disk (defaults to
# ./data and ./uploads). On Vercel the default is /tmp, which is wiped between
# invocations, so point these at a mounted volume for durable history.
# DEEPROMEO_DATA_DIR=/var/lib/deepromeo
# DEEPROMEO_UPLOADS_DIR=/var/lib/deepromeo/uploads
